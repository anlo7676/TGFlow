#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ENV_FILE="$ROOT_DIR/.env"
ENV_EXAMPLE="$ROOT_DIR/.env.example"

random_hex() {
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -hex "$1"
    else
        head -c "$1" /dev/urandom | od -An -tx1 | tr -d ' \n'
    fi
}

random_base64() {
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -base64 32 | tr -d '\n'
    else
        head -c 32 /dev/urandom | base64 | tr -d '\n'
    fi
}

set_env() {
    key=$1
    value=$2
    case "$key" in
        ''|*[!A-Z0-9_]*) echo "配置名只能包含大写字母、数字和下划线。" >&2; exit 1 ;;
    esac
    case "$value" in
        *'\n'*|*'\r'*) echo "配置值不能包含换行。" >&2; exit 1 ;;
    esac

    temp_file="${ENV_FILE}.tmp.$$"
    found=false
    : > "$temp_file"
    if [ -f "$ENV_FILE" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                "$key="*) printf '%s=%s\n' "$key" "$value" >> "$temp_file"; found=true ;;
                *) printf '%s\n' "$line" >> "$temp_file" ;;
            esac
        done < "$ENV_FILE"
    fi
    if [ "$found" = false ]; then
        printf '%s=%s\n' "$key" "$value" >> "$temp_file"
    fi
    mv "$temp_file" "$ENV_FILE"
    chmod 600 "$ENV_FILE" 2>/dev/null || true
}

get_env() {
    key=$1
    [ -f "$ENV_FILE" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            "$key="*) printf '%s\n' "${line#*=}"; return 0 ;;
        esac
    done < "$ENV_FILE"
}

ensure_env() {
    if [ ! -f "$ENV_FILE" ]; then
        cp "$ENV_EXAMPLE" "$ENV_FILE"
    fi
    [ -n "$(get_env APP_KEY)" ] || set_env APP_KEY "base64:$(random_base64)"
    [ -n "$(get_env SSH_MASTER_KEY)" ] || set_env SSH_MASTER_KEY "$(random_base64)"
    [ -n "$(get_env ADMIN_TOTP_KEY)" ] || set_env ADMIN_TOTP_KEY "$(random_base64)"
    [ -n "$(get_env DB_PASSWORD)" ] || set_env DB_PASSWORD "$(random_hex 24)"
    [ -n "$(get_env DB_ROOT_PASSWORD)" ] || set_env DB_ROOT_PASSWORD "$(random_hex 24)"
    [ -n "$(get_env ADMIN_PASSWORD)" ] || set_env ADMIN_PASSWORD "TGFlow-$(random_hex 12)!"
    chmod 600 "$ENV_FILE" 2>/dev/null || true
}

compose() {
    docker compose --project-directory "$ROOT_DIR" "$@"
}

show_help() {
    cat <<'EOF'
TGFlow 部署命令

  ./tgflow deploy                 一键初始化并启动全部服务
  ./tgflow env set KEY VALUE      设置 .env 配置
  ./tgflow env get KEY            查看单项配置
  ./tgflow env list               查看配置（敏感值会隐藏）
  ./tgflow status                 查看服务状态
  ./tgflow logs                   查看服务日志
  ./tgflow restart                重启服务
  ./tgflow stop                   停止服务（保留数据）
EOF
}

command=${1:-help}
case "$command" in
    deploy)
        command -v docker >/dev/null 2>&1 || { echo "未找到 Docker，请先安装 Docker Engine 与 Compose 插件。" >&2; exit 1; }
        docker compose version >/dev/null 2>&1 || { echo "未找到 Docker Compose 插件。" >&2; exit 1; }
        ensure_env
        compose up -d --build --remove-orphans
        port=$(get_env PANEL_PORT); port=${port:-8012}
        username=$(get_env ADMIN_USERNAME); username=${username:-admin}
        echo
        echo "TGFlow 已启动：http://localhost:$port"
        echo "管理员用户名：$username"
        echo "管理员密码：$(get_env ADMIN_PASSWORD)"
        echo "请登录后妥善保存凭据；可用 ./tgflow env set 修改部署配置。"
        ;;
    env)
        action=${2:-}
        case "$action" in
            set)
                [ "$#" -eq 4 ] || { echo "用法：./tgflow env set KEY VALUE" >&2; exit 1; }
                [ -f "$ENV_FILE" ] || cp "$ENV_EXAMPLE" "$ENV_FILE"
                set_env "$3" "$4"
                echo "已更新 $3。重新部署请执行 ./tgflow deploy。"
                ;;
            get)
                [ "$#" -eq 3 ] || { echo "用法：./tgflow env get KEY" >&2; exit 1; }
                get_env "$3"
                ;;
            list)
                [ -f "$ENV_FILE" ] || { echo "尚未生成 .env，请先执行 ./tgflow deploy。"; exit 0; }
                sed -E '/^(APP_KEY|SSH_MASTER_KEY|ADMIN_TOTP_KEY|DB_PASSWORD|DB_ROOT_PASSWORD|ADMIN_PASSWORD|EPAY_KEY|TELEGRAM_BOT_TOKEN|TELEGRAM_WEBHOOK_SECRET)=/s/=.*/=********/' "$ENV_FILE"
                ;;
            *) echo "用法：./tgflow env {set|get|list}" >&2; exit 1 ;;
        esac
        ;;
    status) compose ps ;;
    logs) compose logs -f --tail=200 ;;
    restart) compose restart ;;
    stop) compose down ;;
    help|-h|--help) show_help ;;
    *) show_help; exit 1 ;;
esac
