# TGFlow Docker 部署配置
PANEL_PORT=8012
APP_URL=http://localhost:8012
PANEL_ALLOWED_ORIGINS=http://localhost:8012
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=warning

# 首次部署自动创建的管理员
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=
ADMIN_TOTP_REQUIRED=false

# 数据库与应用密钥（执行 ./tgflow deploy 时自动生成）
DB_DATABASE=tgflow
DB_USERNAME=tgflow
DB_PASSWORD=
DB_ROOT_PASSWORD=
APP_KEY=
SSH_MASTER_KEY=
SSH_MASTER_KEY_VERSION=v1
SSH_PREVIOUS_MASTER_KEYS_JSON={}
ADMIN_TOTP_KEY=

# 可选业务配置，可部署后使用 ./tgflow env set KEY VALUE 设置
ALLOWED_SSH_NETWORKS=
MTPROXYMAX_VERSION=
MTPROXYMAX_SHA256=
EPAY_BASE_URL=
EPAY_PID=
EPAY_KEY=
EPAY_NOTIFY_URL=
EPAY_RETURN_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SESSION_SECURE_COOKIE=false
